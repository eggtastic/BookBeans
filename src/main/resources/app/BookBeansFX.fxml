<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="app.Controller">

    <center>

        <SplitPane
            dividerPositions="0.65"
            prefWidth="1000.0"
            prefHeight="600.0">

            <!-- ================================================= -->
            <!-- LEFT SIDE -->
            <!-- ================================================= -->

            <VBox
                spacing="10.0"
                prefWidth="650.0">

                <padding>
                    <Insets
                        top="10.0"
                        right="10.0"
                        bottom="10.0"
                        left="10.0"/>
                </padding>


                <!-- STORE BUTTONS -->

                <HBox spacing="10.0">

                    <Button
                        text="Bookstore"
                        onAction="#handleBookstore"
                        prefWidth="120.0"/>

                    <Button
                        text="Cafe"
                        onAction="#handleCafe"
                        prefWidth="120.0"/>

                </HBox>


                <!-- PRODUCT TABLE -->

                <TableView
                    fx:id="productTable"
                    VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn
                            fx:id="nameColumn"
                            text="Name"
                            prefWidth="150.0"/>

                        <TableColumn
                            fx:id="priceColumn"
                            text="Price"
                            prefWidth="80.0"/>

                        <TableColumn
                            fx:id="stockColumn"
                            text="Stock"
                            prefWidth="60.0"/>

                        <TableColumn
                            fx:id="genreColumn"
                            text="Genre"
                            prefWidth="100.0"/>

                        <TableColumn
                            fx:id="releaseColumn"
                            text="Release"
                            prefWidth="70.0"/>

                        <TableColumn
                            fx:id="creatorColumn"
                            text="Creator"
                            prefWidth="120.0"/>

                        <TableColumn
                            fx:id="detailsColumn"
                            text="Details"
                            prefWidth="90.0"/>

                    </columns>

                </TableView>


                <!-- PRODUCT TYPE -->

                <HBox spacing="10.0">

                    <Label
                        text="Product Type:"/>

                    <ComboBox
                        fx:id="productTypeComboBox"
                        prefWidth="150.0"/>

                </HBox>


                <!-- BASIC FIELDS -->

                <HBox spacing="10.0">

                    <TextField
                        fx:id="nameField"
                        promptText="Name"
                        HBox.hgrow="ALWAYS"/>

                    <TextField
                        fx:id="priceField"
                        promptText="Price"
                        HBox.hgrow="ALWAYS"/>

                    <TextField
                        fx:id="stockField"
                        promptText="Stock"
                        HBox.hgrow="ALWAYS"/>

                </HBox>


                <!-- MEDIA FIELDS -->

                <HBox spacing="10.0">

                    <TextField
                        fx:id="genreField"
                        promptText="Genre"
                        HBox.hgrow="ALWAYS"/>

                    <TextField
                        fx:id="releaseField"
                        promptText="Release"
                        HBox.hgrow="ALWAYS"/>

                    <TextField
                        fx:id="creatorField"
                        promptText="Creator"
                        HBox.hgrow="ALWAYS"/>

                </HBox>


                <!-- BOOK / MOVIE DETAILS -->

                <HBox spacing="10.0">

                    <TextField
                        fx:id="pageCountField"
                        promptText="Page Count"
                        HBox.hgrow="ALWAYS"/>

                    <TextField
                        fx:id="runtimeField"
                        promptText="Runtime"
                        HBox.hgrow="ALWAYS"/>

                </HBox>


                <!-- CRUD / BUY -->

                <HBox spacing="10.0">

                    <Button
                        text="Delete"
                        onAction="#handleDelete"
                        prefWidth="100.0"/>

                    <Button
                        text="Update"
                        onAction="#handleUpdate"
                        prefWidth="100.0"/>

                    <Button
                        text="Buy Selected"
                        onAction="#handleBuy"
                        prefWidth="120.0"/>

                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- RIGHT SIDE -->
            <!-- ================================================= -->

            <VBox
                spacing="10.0"
                prefWidth="350.0">

                <padding>
                    <Insets
                        top="15.0"
                        right="15.0"
                        bottom="15.0"
                        left="15.0"/>
                </padding>


                <!-- AZIRA IMAGE -->

                <StackPane
                    prefHeight="180.0">

                    <ImageView
                        fx:id="librarianImage"
                        fitWidth="180.0"
                        fitHeight="180.0"
                        preserveRatio="true"
                        smooth="true"/>

                </StackPane>


                <!-- LIBRARIAN NAME -->

                <Label
                    text="Librarian"
                    alignment="CENTER"
                    maxWidth="Infinity">

                    <font>
                        <Font
                            size="22.0"
                            name="System Bold"/>
                    </font>

                </Label>


                <!-- ================================================= -->
                <!-- DIALOGUE -->
                <!-- ================================================= -->

                <VBox
                    spacing="5.0"
                    VBox.vgrow="ALWAYS">

                    <Label
                        fx:id="dialogueLabel"
                        text="Welcome to the Bookstore!"
                        wrapText="true"
                        alignment="TOP_LEFT"
                        maxWidth="Infinity"
                        minHeight="150.0"
                        prefHeight="180.0"
                        VBox.vgrow="ALWAYS"
                        style="
                            -fx-border-color: #999999;
                            -fx-border-width: 1;
                            -fx-padding: 12;
                            -fx-background-color: #f7f7f7;
                        "/>

                </VBox>


                <!-- EARNINGS -->

                <Label
                    fx:id="earningsLabel"
                    text="Earnings: PHP 0.00"
                    alignment="CENTER"
                    maxWidth="Infinity">

                    <font>
                        <Font size="15.0"/>
                    </font>

                </Label>


                <!-- ================================================= -->
                <!-- STOCK BUTTONS -->
                <!-- ================================================= -->

                <HBox
                    spacing="8.0"
                    alignment="CENTER">

                    <Button
                        fx:id="bookStockButton"
                        text="Book Stock?"
                        onAction="#handleBookStock"
                        prefWidth="105.0"/>

                    <Button
                        fx:id="movieStockButton"
                        text="Movie Stock?"
                        onAction="#handleMovieStock"
                        prefWidth="105.0"/>

                    <Button
                        fx:id="consumablesStockButton"
                        text="Consumables Stock?"
                        onAction="#handleConsumablesStock"
                        visible="false"
                        managed="false"
                        prefWidth="130.0"/>

                </HBox>

            </VBox>

        </SplitPane>

    </center>

</BorderPane>