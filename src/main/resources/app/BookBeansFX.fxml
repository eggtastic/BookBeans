<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER"
      maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="600.0"
      prefWidth="1000.0"
      spacing="5.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.Controller">

    <children>

        <Label text="BookBeans">
            <font>
                <Font size="24.0"/>
            </font>
        </Label>

        <SplitPane dividerPositions="0.25, 0.75"
                   focusTraversable="true"
                   prefHeight="-1.0"
                   prefWidth="-1.0">

            <items>

                <AnchorPane>
                    <children>
                        <Label alignment="CENTER"
                               layoutX="14.0"
                               layoutY="14.0"
                               text="Master"
                               textAlignment="CENTER"/>
                    </children>
                </AnchorPane>

                <ScrollPane prefHeight="-1.0"
                            prefWidth="-1.0">

                    <content>

                        <AnchorPane minHeight="-1.0"
                                    minWidth="-1.0"
                                    prefHeight="545.0"
                                    prefWidth="430.0">

                            <children>

                                <Label alignment="CENTER"
                                       layoutX="14.0"
                                       layoutY="14.0"
                                       text="View"
                                       textAlignment="CENTER">

                                    <font>
                                        <Font size="18.0"/>
                                    </font>

                                    <textFill>
                                        <Color red="0.624"
                                               green="0.624"
                                               blue="0.624"/>
                                    </textFill>

                                </Label>

                            </children>

                        </AnchorPane>

                    </content>

                </ScrollPane>

                <AnchorPane>
                    <children>
                        <Label alignment="CENTER"
                               layoutX="14.0"
                               layoutY="14.0"
                               text="Icon Here"
                               textAlignment="CENTER"/>
                    </children>
                </AnchorPane>

            </items>

        </SplitPane>

        <Label alignment="CENTER"
               minWidth="60.0"
               text="Bookstore/Cafe (will change depending on player choice)"
               textAlignment="CENTER"
               wrapText="false">

            <font>
                <Font size="18.0"/>
            </font>

            <textFill>
                <Color red="0.624"
                       green="0.624"
                       blue="0.624"/>
            </textFill>

        </Label>

        <ScrollPane prefHeight="-1.0"
                    prefWidth="-1.0">

            <content>

                <AnchorPane minHeight="-1.0"
                            minWidth="-1.0"
                            prefHeight="545.0"
                            prefWidth="430.0">

                    <children>

                        <Label alignment="CENTER"
                               layoutX="14.0"
                               layoutY="14.0"
                               text="View"
                               textAlignment="CENTER">

                            <font>
                                <Font size="18.0"/>
                            </font>

                            <textFill>
                                <Color red="0.624"
                                       green="0.624"
                                       blue="0.624"/>
                            </textFill>

                        </Label>

                    </children>

                </AnchorPane>

            </content>

        </ScrollPane>

        <AnchorPane>

            <children>

                <Label alignment="CENTER"
                       layoutX="14.0"
                       layoutY="14.0"
                       text="Idk yet"
                       textAlignment="CENTER"
                       wrapText="false">

                    <font>
                        <Font size="18.0"/>
                    </font>

                    <textFill>
                        <Color red="0.624"
                               green="0.624"
                               blue="0.624"/>
                    </textFill>

                </Label>

            </children>

        </AnchorPane>

    </children>

</VBox>