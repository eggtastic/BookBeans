<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER"
      maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="600.0"
      prefWidth="1000.0"
      spacing="5.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.Controller">

    <children>

        <!-- BookBeans Title -->
        <Label text="BookBeans">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <SplitPane dividerPositions="0.65"
                   focusTraversable="true"
                   prefHeight="550.0"
                   prefWidth="1000.0">

            <items>

                <!-- LEFT SIDE -->
                <VBox prefHeight="548.0"
                      prefWidth="700.0"
                      spacing="10.0">

                    <children>

                        <!-- Store Buttons -->
                        <HBox alignment="CENTER"
                              prefWidth="500.0"
                              style="-fx-padding: 10 30 10 30;">

                            <children>

                                <Button mnemonicParsing="false"
                                        text="Bookstore" />

                                <Region HBox.hgrow="ALWAYS" />

                                <Button mnemonicParsing="false"
                                        text="Cafe" />

                            </children>

                        </HBox>

                        <!-- Product Table -->
                        <TableView fx:id="productTable"
                                   VBox.vgrow="ALWAYS">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>

                            <columns>

                                <TableColumn fx:id="nameColumn"
                                             text="Name" />

                                <TableColumn fx:id="priceColumn"
                                             text="Price" />

                                <TableColumn fx:id="stockColumn"
                                             text="Stock" />

                                <TableColumn fx:id="genreColumn"
                                             text="Genre" />

                                <TableColumn fx:id="releaseColumn"
                                             text="Release" />

                                <TableColumn fx:id="creatorColumn"
                                             text="Creator" />

                                <TableColumn fx:id="detailsColumn"
                                             text="Details" />

                            </columns>

                        </TableView>

                        <!-- Product Input Fields -->
                        <VBox spacing="8.0">

                            <!-- Basic Product Information -->
                            <HBox spacing="8.0">

                                <TextField fx:id="nameField"
                                           promptText="Product name"
                                           HBox.hgrow="ALWAYS" />

                                <TextField fx:id="priceField"
                                           promptText="Price"
                                           HBox.hgrow="ALWAYS" />

                                <TextField fx:id="stockField"
                                           promptText="Stock"
                                           HBox.hgrow="ALWAYS" />

                            </HBox>

                            <!-- Media Information -->
                            <HBox spacing="8.0">

                                <TextField fx:id="genreField"
                                           promptText="Genre"
                                           HBox.hgrow="ALWAYS" />

                                <TextField fx:id="releaseField"
                                           promptText="Release year"
                                           HBox.hgrow="ALWAYS" />

                                <TextField fx:id="creatorField"
                                           promptText="Creator"
                                           HBox.hgrow="ALWAYS" />

                            </HBox>

                            <!-- Book / Movie Specific Information -->
                            <HBox spacing="8.0">

                                <TextField fx:id="pageCountField"
                                           promptText="Page count"
                                           HBox.hgrow="ALWAYS" />

                                <TextField fx:id="runtimeField"
                                           promptText="Runtime"
                                           HBox.hgrow="ALWAYS" />

                                <Button mnemonicParsing="false"
                                        text="Add Product"
                                        HBox.hgrow="ALWAYS" />

                            </HBox>

                        </VBox>

                        <!-- Product Actions -->
                        <HBox alignment="CENTER"
                              spacing="10.0"
                              style="-fx-padding: 5 0 10 0;">

                            <Button mnemonicParsing="false"
                                    text="Delete"
                                    prefWidth="100.0" />

                            <Button mnemonicParsing="false"
                                    text="Update"
                                    prefWidth="100.0" />

                            <Button mnemonicParsing="false"
                                    text="Buy Selected"
                                    prefWidth="120.0" />

                        </HBox>

                    </children>

                </VBox>

                <!-- RIGHT SIDE -->
                <VBox alignment="TOP_CENTER"
                      prefHeight="548.0"
                      prefWidth="350.0"
                      spacing="15.0">

                    <children>

                        <!-- Librarian Image Placeholder -->
                        <Label alignment="CENTER"
                               prefHeight="300.0"
                               prefWidth="300.0"
                               text="Librarian Icon Here"
                               textAlignment="CENTER" />

                        <!-- Character Name -->
                        <Label alignment="CENTER"
                               prefHeight="30.0"
                               prefWidth="300.0"
                               text="Librarian Name">

                            <font>
                                <Font size="18.0" />
                            </font>

                        </Label>

                        <!-- Dialogue Box -->
                        <VBox alignment="CENTER_LEFT"
                              prefHeight="120.0"
                              prefWidth="320.0"
                              spacing="5.0"
                              style="-fx-border-color: black; -fx-border-width: 1; -fx-padding: 10;">

                            <children>

                                <Label fx:id="dialogueLabel"
                                       text="Welcome to BookBeans!"
                                       wrapText="true" />

                            </children>

                        </VBox>

                    </children>

                </VBox>

            </items>

        </SplitPane>

        <!-- Bottom Space -->
        <AnchorPane prefHeight="20.0" />

    </children>

</VBox>